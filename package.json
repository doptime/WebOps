{
  "name": "@webops/v6",
  "version": "6.0.0",
  "description": "WebOps V6 — drive a React/Next.js/R3F app, capture the session as video frames + audio + a ms-anchored event timeline, and feed it to a multimodal model (Qwen3-Omni via vLLM). No K-line, no numeric telemetry.",
  "type": "module",
  "main": "./agent.ts",
  "exports": {
    ".": "./agent.ts",
    "./runtime": "./runtime.ts",
    "./script": "./script--Script.ts",
    "./session": "./session--SessionRunner.ts",
    "./report": "./report--ReportBuilder.ts",
    "./media": "./report--MediaPayload.ts",
    "./react": "./react--useTrack.ts",
    "./zustand": "./react--zustand-telemetry.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "zustand": ">=4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/react": "^18.2.0"
  }
}
